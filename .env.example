# Copy to .env.local for local development. Never commit real values.

# Public URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://nordicwide.com

# --- Contact form delivery -------------------------------------------------
# Configure ONE of the options below. Without a provider, the form logs
# submissions in development and shows a "temporarily unavailable" message
# (with email/phone fallback) in production.

# Option 1: Email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@nordicwide.com
CONTACT_FROM_EMAIL="Nordic Wide <website@nordicwide.com>"

# Option 2: Webhook (CRM, Zapier, Make, Slack, ...) — receives JSON
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
